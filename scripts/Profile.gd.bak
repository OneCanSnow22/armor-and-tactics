class Attack extends Resource:
	@export var code:String
	@export var damage:int
	@export var price:int
	func _init(ui:int)->void:
		damage=ui
	func attack():
		print("攻击")
	func enhance(value:int):
		damage+=value
	func evaluate_price():
		print("评估价格")
class Melee extends Attack:
	@export var range:int#攻击范围
	@export var max_range:int
	func _init(damage:int,info:int):
		self.damage=damage
		range=info
		max_range=range
	func attack():
		print("斩击")
	func evaluate_price():
		price=20
		price*=(1+0.08*damage+0.12*max_range)
		return price
class Shoot extends Attack:
	@export var probability:int#攻击命中率
	@export var max_probability:int
	func _init(damage:int,info:int):
		self.damage=damage
		probability=info
		max_probability=probability
	func attack():
		print("射击")
	func evaluate_price():
		price=20
		price*=(1+0.1*damage+0.04*max_probability)
		return price
class Through_shoot extends Shoot:#贯穿射击
	@export var level:int#贯穿等级
	func _init(damage:int,info:int,level:int):
		self.damage=damage
		probability=info
		max_probability=probability
		self.level=level
	func attack():
		print("射击")
	func evaluate_price():
		price=30
		price*=(1+0.1*damage+0.04*max_probability+0.15*level)
		return price
class Missile extends Resource:#导弹类型
	@export var isCanBeUsed:bool
	@export var Mname:String
class Firebomb extends Missile:
	func _init(value:bool) -> void:
		Mname="燃烧弹"
		isCanBeUsed=value
class FlashBang extends Missile:
	func _init(value:bool) -> void:
		Mname="闪光弹"
		isCanBeUsed=value
class Flare extends Missile:
	func _init(value:bool) -> void:
		Mname="干扰弹"
		isCanBeUsed=value
class Shelling extends Attack:
	@export var time:int#延时回合
	@export var firebomb:Firebomb
	@export var flashbang:FlashBang
	@export var flare:Flare
	@export var current_missile:Missile
	@export var max_time:int
	@export var current_time:int#触发炮击还需要的回合数
	@export var bonus_damage:int = 0#等待期内由攻击模组叠加的额外伤害
	@export var is_targeting:bool = false#敌人炮击专用：是否已锁定玩家（替代全局 playerIsTarget）
	func _init(damage:int,info:int):
		firebomb=Firebomb.new(true)
		flashbang=FlashBang.new(true)
		flare=Flare.new(true)
		current_missile=null
		self.damage=damage
		time=info
		max_time=time
	func attack():
		print("炮击")
	func evaluate_price():
		price=30
		var rate=1.0
		if firebomb.isCanBeUsed:
			rate+=0.08
		if flashbang.isCanBeUsed:
			rate+=0.08
		if flare.isCanBeUsed:
			rate+=0.08
		rate+=(damage*0.08)
		rate-=(max_time*0.08)
		if rate<0.3:
			rate=0.3
		price*=rate
		return price
class Multi_target_missile extends Shelling:
	func attack():
		print("多目标炮击")
	func evaluate_price():
		price=40
		var rate=1.0
		if firebomb.isCanBeUsed:
			rate+=0.08
		if flashbang.isCanBeUsed:
			rate+=0.08
		if flare.isCanBeUsed:
			rate+=0.08
		rate+=(damage*0.08)
		rate-=(max_time*0.08)
		if rate<0.3:
			rate=0.3
		price*=rate
		return price
class Sputtering_type_artillery extends Shelling:
	@export var sputter_range:int
	func _init(damage:int,info:int,sr:int):
		super._init(damage,info)
		self.damage=damage
		self.sputter_range=sr
	func attack():
		print("溅射型炮击")
	func evaluate_price():
		price=40
		var rate=1.0
		if firebomb.isCanBeUsed:
			rate+=0.08
		if flashbang.isCanBeUsed:
			rate+=0.08
		if flare.isCanBeUsed:
			rate+=0.08
		rate+=(damage*0.08)
		rate-=(max_time*0.1)
		rate+=(sputter_range*0.12)
		if rate<0.3:
			rate=0.3
		price*=rate
		return price
class Strike_type_artillery extends Shelling:
	## 打击型炮击：直接锁定所有目标，不需要选中某个敌人
	func attack():
		print("打击型炮击")
	func evaluate_price():
		price=40
		var rate=1.0
		if firebomb.isCanBeUsed:
			rate+=0.08
		if flashbang.isCanBeUsed:
			rate+=0.08
		if flare.isCanBeUsed:
			rate+=0.1
		rate+=(damage*0.08)
		rate-=(max_time*0.08)
		if rate<0.3:
			rate=0.3
		price*=rate
		return price
